    "from ultralytics import YOLO\n",
    "\n",
    "# Load a YOLOv8 model (use 'yolov8n.pt', 'yolov8s.pt', etc. for different sizes)\n",
    "model = YOLO('yolov8n.pt')\n",
    "\n",
    "# Train the model\n",
    "model.train(\n",
    "    data='data.yaml',\n",
    "    epochs=50,\n",
    "    imgsz=640,\n",
    "    batch=16,\n",
    "    project='yolov8_runs'\n",
    ")"
   ]
